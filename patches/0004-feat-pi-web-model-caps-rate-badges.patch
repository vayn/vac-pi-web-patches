+/**
+ * Display-only per-model metadata (fee multiplier etc.), synced from the upstream gateway panel
+ * `/api/fees` by the sync script into `~/.pi/agent/model-caps.json`.
+ *
+ * Why a sidecar instead of models.json: the fee multiplier is a relative factor of the
+ * upstream base price, not a USD price, so it must not go into models.json's `cost`
+ * (that field feeds usage/billing display). Absent file → no badges, everything else works.
+ */
+type ModelCapsEntry = { rate?: number | null; free?: boolean };
+type ModelCapsDoc = { models?: Record<string, ModelCapsEntry> };
+
+async function loadModelCaps(): Promise<Record<string, ModelCapsEntry>> {
+  try {
+    const raw = await readFile(resolve(getAgentDir(), "model-caps.json"), "utf8");
+    const doc = JSON.parse(raw) as ModelCapsDoc;
+    return doc.models ?? {};
+  } catch {
+    return {};
+  }
+}
