diff --git a/components/TableZoom.tsx b/components/TableZoom.tsx
new file mode 100644
index 0000000..ab5d985
--- /dev/null
+++ b/components/TableZoom.tsx
@@ -0,0 +1,119 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { useI18n } from "@/hooks/useI18n";
+
+/**
+ * 表格放大（维护者 2026-10-04 要求）：为 markdown 表格提供「放大」按钮与全屏查看。
+ *
+ * 设计对齐本仓 ImagePreview（components/ImagePreview.tsx）：
+ *   - 触发按钮 → <dialog> → ::backdrop + 关闭按钮；
+ *   - 关闭时恢复 body overflow 并把焦点还给触发按钮（无障碍）；
+ *   - Esc / 点击遮罩空白关闭。
+ *
+ * 与 ImagePreview 的差异（表格特有的两点）：
+ *   1. 按钮浮在表格右上角而非包裹整个表格——表格本身可横向滚动、可交互，
+ *      包裹成 <button> 会破坏滚动与选区（且 button 内嵌 table 不合法）。
+ *   2. 全屏态表格需双向滚动（宽表横滚 + 长表纵滚），故 dialog 内用
+ *      .table-zoom-dialog-scroll 承载，而非 ImagePreview 的居中 contain。
+ */
+interface TableZoomProps {
+  children: React.ReactNode;
+}
+
+export function TableZoom({ children }: TableZoomProps) {
+  const { t } = useI18n();
+  const [open, setOpen] = useState(false);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const closeButtonRef = useRef<HTMLButtonElement>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    const trigger = triggerRef.current;
+
+    const previousOverflow = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    dialog.showModal();
+    closeButtonRef.current?.focus({ preventScroll: true });
+
+    return () => {
+      document.body.style.overflow = previousOverflow;
+      if (dialog.open) dialog.close();
+      if (trigger?.isConnected) {
+        trigger.focus({ preventScroll: true });
+      }
+    };
+  }, [open]);
+
+  const closeZoom = () => {
+    if (dialogRef.current?.open) dialogRef.current.close();
+    setOpen(false);
+  };
+
+  return (
+    <div className="table-zoom">
+      <div className="markdown-table-wrap">
+        <table>{children}</table>
+      </div>
+      <button
+        ref={triggerRef}
+        type="button"
+        className="table-zoom-button"
+        onClick={() => setOpen(true)}
+        aria-label={t("chat.zoomTable")}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        title={t("chat.zoomTable")}
+      >
+        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+          <path d="M9.4 3.2H4.6a1.4 1.4 0 0 0-1.4 1.4v4.8" />
+          <path d="M14.6 3.2h4.8a1.4 1.4 0 0 1 1.4 1.4v4.8" />
+          <path d="M20.8 14.6v4.8a1.4 1.4 0 0 1-1.4 1.4h-4.8" />
+          <path d="M3.2 14.6v4.8a1.4 1.4 0 0 0 1.4 1.4h4.8" />
+        </svg>
+      </button>
+      {open && (
+        <dialog
+          ref={dialogRef}
+          className="table-zoom-dialog"
+          aria-label={t("chat.zoomTable")}
+          onCancel={(event) => {
+            event.preventDefault();
+            event.stopPropagation();
+            closeZoom();
+          }}
+          onKeyDown={(event) => {
+            if (event.key !== "Escape") return;
+            event.preventDefault();
+            event.stopPropagation();
+            closeZoom();
+          }}
+          onClick={(event) => {
+            if (event.target === event.currentTarget) closeZoom();
+          }}
+        >
+          <div className="table-zoom-dialog-scroll">
+            <div className="markdown-table-wrap table-zoom-dialog-table">
+              <table>{children}</table>
+            </div>
+          </div>
+          <button
+            ref={closeButtonRef}
+            type="button"
+            className="table-zoom-close"
+            onClick={closeZoom}
+            aria-label={t("chat.close")}
+            title={t("chat.close")}
+          >
+            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
+              <path d="M6 6l12 12M18 6 6 18" />
+            </svg>
+          </button>
+        </dialog>
+      )}
+    </div>
+  );
+}
