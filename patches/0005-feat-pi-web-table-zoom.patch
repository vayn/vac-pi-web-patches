diff --git a/app/globals.css b/app/globals.css
index 3399e0a..929f434 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -863,6 +863,112 @@ pre, code {
   color: color-mix(in srgb, var(--text) 88%, var(--text-muted));
   font-weight: 650;
 }
+
+/* ---- 表格放大（维护者 2026-10-04；组件 components/TableZoom.tsx）----
+   触发按钮浮于表格右上角：桌面 hover 才完全显现，触屏（无 hover）保持低透明度常驻可点——
+   参照该移动端组件的结论「触屏无 hover，图标须常驻可见」。 */
+.table-zoom {
+  position: relative;
+}
+.table-zoom-button {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  z-index: 2;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 26px;
+  height: 26px;
+  padding: 0;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: var(--bg-panel);
+  color: var(--text-muted);
+  cursor: zoom-in;
+  opacity: 0.55;
+  transition: opacity 0.15s ease, color 0.15s ease, background-color 0.15s ease;
+}
+.table-zoom-button:hover,
+.table-zoom-button:focus-visible {
+  opacity: 1;
+  color: var(--text);
+  background: var(--bg-hover);
+}
+@media (hover: none) {
+  /* 触屏无 hover：常驻可点，避免「看不见也点不到」 */
+  .table-zoom-button { opacity: 0.85; }
+}
+
+.table-zoom-dialog {
+  position: fixed;
+  inset: 0;
+  width: 100vw;
+  max-width: none;
+  height: 100dvh;
+  max-height: none;
+  margin: 0;
+  padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
+           max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
+  border: 0;
+  background: transparent;
+  color: var(--text);
+  overflow: hidden;
+}
+.table-zoom-dialog[open] { display: block; }
+.table-zoom-dialog::backdrop { background: rgba(0, 0, 0, 0.72); }
+
+/* 全屏态：表格**优先自动折行**（见下），纵向溢出时滚动；
+   极宽的窄列多列表（如 20 列）仍会超出宽度→由本容器的 overflow:auto 提供横向滚动兑底。 */
+.table-zoom-dialog-scroll {
+  width: 100%;
+  height: 100%;
+  overflow: auto;
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+}
+.table-zoom-dialog-table {
+  margin: 0;
+  border: 0;
+  border-radius: 0;
+  /* 取消 .markdown-table-wrap 的 overflow-x:auto，改由外层 scroll 容器统一双向滚动 */
+  overflow: visible;
+}
+/* 上游 .markdown-table-wrap > table 是 width:max-content（窄框内不折行、横向滚动）——
+   全屏态的目标相反：**优先自动折行**，让单元格在可用宽度内换行，而不是一行到底。
+   注意特异性：上游选择器与本块同为 (0,1,1)，因此**不能只靠源码顺序**（脆弱）；
+   此处用 .table-zoom-dialog-scroll 前缀把特异度抬到 (0,2,1)，确保稳定覆盖。 */
+.table-zoom-dialog-scroll .table-zoom-dialog-table > table {
+  width: 100%;
+  table-layout: auto;
+}
+.table-zoom-dialog-scroll .table-zoom-dialog-table th,
+.table-zoom-dialog-scroll .table-zoom-dialog-table td {
+  /* wrap-anywhere 同上游 .markdown-body 的断词策略；normal 允许在空格处折行 */
+  white-space: normal;
+  overflow-wrap: anywhere;
+  /* 窄屏下给列一个可读下限，避免多列表被挤成竖排单字 */
+  min-width: 6ch;
+}
+
+.table-zoom-close {
+  position: absolute;
+  top: max(12px, env(safe-area-inset-top));
+  right: max(12px, env(safe-area-inset-right));
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  padding: 0;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-panel);
+  color: var(--text);
+  cursor: pointer;
+}
+.table-zoom-close:hover { background: var(--bg-hover); }
 .markdown-body tbody tr:nth-child(even) td { background: var(--bg-subtle); }
 .markdown-body hr {
   border: none;
