+/**
+ * 冷却态（router 运行态熔断）——`error-state.json` 里 `until > now` 的条目。
+ *
+ * 为何**不走** model-caps.json 静态快照（与人工禁用名单 `disabled` 分道）：
+ *  1. 语义分层——`disabled` 是人工 + 临时（恢复后手动删行），冷却是自动 +
+ *     自愈（到期即失效）。混在同一静态文件里会让「自动恢复」退化成「必须
+ *     有人记得重跑 the sync script」，正是 维护者裁定 划分两套机制的原因。
+ *  2. 时效——快照只在手动 sync 时更新；冷却可能几分钟前刚发生、也可能刚刚
+ *     结束，两个方向都会失真。本路由是 `force-dynamic`，实时读的成本只是一次
+ *     几 KB 的 readFile。
+ *
+ * 键口径：error-state 的键与 `m.id` **同口径**（`<channel>/<model>`，provider
+ * 恒为 provider），故可直接下标命中，无需像禁用名单那样做后缀匹配。
+ */
+type CooldownEntry = { until: number; reason?: string };
+
+function routerStateDir(): string {
+  // 与 model-router.ts 的 STATE_DIR 同一解析规则（MODEL_ROUTER_STATE_DIR 优先），
+  // 否则隔离/测试环境的覆盖会与 router 真源分叉。
+  return process.env.MODEL_ROUTER_STATE_DIR
+    || resolve(homedir(), ".local", "state", "model-router");
+}
+
+async function loadCooldowns(): Promise<Record<string, CooldownEntry>> {
+  try {
+    const raw = await readFile(resolve(routerStateDir(), "error-state.json"), "utf8");
+    const doc = JSON.parse(raw) as Record<string, { until?: number; reason?: string } | undefined>;
+    const now = Date.now();
+    const out: Record<string, CooldownEntry> = {};
+    for (const [modelId, v] of Object.entries(doc ?? {})) {
+      // 过期条目必须丢弃：router 侧过期即不再挡候选链，UI 若还挂着「禁止」
+      // 会造成「不可点但其实能用」的错位——比不显示更糟。
+      if (!v || typeof v.until !== "number" || v.until <= now) continue;
+      out[modelId] = { until: v.until, reason: typeof v.reason === "string" ? v.reason : undefined };
+    }
+    return out;
+  } catch {
+    // 文件不存在 = router 从未熔断过（正常态），不是错误。
+    return {};
+  }
+}
