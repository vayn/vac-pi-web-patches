+/** 冷却 tooltip 的固定前缀——必须写明「自动恢复、无需操作」，否则与人工禁用混淆。 */
+const COOLDOWN_TITLE_BASE = "冷却中（router 自动熔断，**非人工禁用**）——到期自动恢复，无需任何操作";
+const COOLDOWN_REASON_TEXT: Record<string, string> = {
+  usage_window: "上游用量窗口限流（6004）",
+  rate_limit: "上游频率限流（429）",
+  unavailable: "上游判定模型不可用",
+};
+/** 到期判定的重算间隔。冷却粒度是分钟级（上游声明的配额重置时刻），
+ *  30s 精度足够，又不会在长列表常开时空转。 */
+const COOLDOWN_TICK_MS = 30_000;
+
+function formatCooldownUntil(until: number): string {
+  const d = new Date(until);
+  const p = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
+}
+
+function cooldownTitle(cooldown: { until: number; reason?: string }): string {
+  const why = cooldown.reason
+    ? COOLDOWN_REASON_TEXT[cooldown.reason] ?? cooldown.reason
+    : "上游临时不可用";
+  return `${COOLDOWN_TITLE_BASE}\n原因：${why}\n预计恢复：${formatCooldownUntil(cooldown.until)}`;
+}
+
+/** 每 intervalMs 推进一次「现在」——冷却到期的**自愈**靠它。
+ *  /api/models 下发的是快照（until 是绝对时刻），若不重渲，标志会一直挂到
+ *  下次刷新（时机不确定）⇒ 表现为「已恢复的模型仍不可点」，比不显示更糟。 */
+function useNow(intervalMs: number): number {
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => {
+    const id = setInterval(() => setNow(Date.now()), intervalMs);
+    return () => clearInterval(id);
+  }, [intervalMs]);
+  return now;
+}
