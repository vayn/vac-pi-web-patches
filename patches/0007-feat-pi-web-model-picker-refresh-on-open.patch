   const [modelsRefreshKey, setModelsRefreshKey] = useState(0);
+  // 模型列表新鲜度：目录刷新（EnabledModelsSection）与选单开单都会 bump 这个 key，
+  // useAgentSession 的 effect 依赖它重新拉 /api/models。
+  // 【为何统一为一个 key】拉取路径只有一条（loadModels），新增需求走同一个 key
+  // 即可，不必新开接口或新开状态——DRY，且避开“第二条刷新路径与第一条行为不一致”。
+  const requestModelsRefresh = useCallback(() => setModelsRefreshKey((key) => key + 1), []);
   const [projectTrust, setProjectTrust] = useState<ProjectTrustStatus | null>(null);
